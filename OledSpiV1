#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

const int buzz = 10;
const int buzznot = 43;
const int button4 = 13;
const int button3 = 7;
const int button2 = 6;
const int button1 = 5;
const int SelectOUT4 = 22;
const int SelectOUT3 = 24; 
const int SelectOUT2 = 22;
const int SelectOUT1 = 24;

bool systemBooted = false;
bool bitmap = false;
bool options = false;
bool buzzing = false;

void setup() {
  Serial.begin(115200); 

  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED failed");
    for(;;);
  }

  display.setTextSize(2);
  display.setTextColor(WHITE);

  pinMode(SelectOUT4, OUTPUT);
  pinMode(buzz, INPUT_PULLUP);

  pinMode(SelectOUT4, OUTPUT);
  pinMode(button4, INPUT_PULLUP);

  pinMode(SelectOUT3, OUTPUT);
  pinMode(button3, INPUT_PULLUP); 

  pinMode(SelectOUT1, OUTPUT);
  pinMode(button1, INPUT_PULLUP); 

  pinMode(SelectOUT2, OUTPUT);
  pinMode(button2, INPUT_PULLUP); 

  unsigned long startBootTime = millis();
  
  while (millis() - startBootTime < 4500) {
    display.clearDisplay();
    display.setCursor(0, 10);
    display.println("Booting...");
    display.setCursor(0, 35);
    display.println("KV31.OS");
    delay(60);
    display.display();
    display.setCursor(0,10);
    display.println("Booting..");
    display.setCursor(0, 35);
    display.println("KV31.OS");

    int dots = ((millis() - startBootTime) / 1000) + 1;
    display.setCursor(0, 52);
    display.setTextSize(1);
    for(int i = 0; i < dots; i++) {
      display.print("-> ");
    }
    display.setTextSize(2);
    
    display.display();
    delay(50);
  }
}

